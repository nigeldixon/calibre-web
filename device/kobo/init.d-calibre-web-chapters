#!/bin/sh
### BEGIN INIT INFO
# Provides:          calibre-web-chapters
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Default-Start:     S 2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Track Kobo reader pages for calibre-web chapter marks
### END INIT INFO

ADDON_DIR=/mnt/onboard/.adds/calibre-web-chapters
TRACKER="$ADDON_DIR/track_page.sh"
PIDFILE=/var/run/calibre-web-chapters.pid

running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(sed -n '1p' "$PIDFILE" 2>/dev/null)
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

start() {
    [ -x "$TRACKER" ] || {
        echo "$TRACKER is missing or not executable"
        return 1
    }
    if running; then
        return 0
    fi
    rm -f "$PIDFILE" 2>/dev/null || true
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -q -m -p "$PIDFILE" -x "$TRACKER"
    else
        "$TRACKER" >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
    fi
}

stop() {
    running || {
        rm -f "$PIDFILE" 2>/dev/null || true
        return 0
    }
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -q -p "$PIDFILE"
    else
        kill "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE" 2>/dev/null || true
}

case "${1:-}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; start ;;
    status)
        if running; then
            echo "calibre-web-chapters page tracker is running"
        else
            echo "calibre-web-chapters page tracker is stopped"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac
