# Calibre-Web chapter marks for NickelMenu
# Copy this file to: .adds/nm/calibre-web-chapters
# Requires NickelMenu and NickelDBus (qndb). Reboot after copying.

# Reader overflow menu: mark the book currently open.
menu_item :reader :Add chapter mark :cmd_spawn :quiet:/mnt/onboard/.adds/calibre-web-chapters/add_chapter.sh

# Main menu: uses the most recently read book.
menu_item :main :Add chapter mark :cmd_spawn :quiet:/mnt/onboard/.adds/calibre-web-chapters/add_chapter.sh

# Diagnostic entry: writes debug.txt instead of opening the browser.
menu_item :main :Add chapter (debug) :cmd_spawn :quiet:/mnt/onboard/.adds/calibre-web-chapters/add_chapter.sh --debug

# Firmware 4.23+ cannot leave the full-screen browser otherwise.
menu_item :browser :Quit :nickel_misc :home
